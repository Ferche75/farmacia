# Plantilla de las variables que necesita apps/admin. Copiar a .env.local
# y completar con los valores reales (ese archivo SÍ está gitignoreado).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ Server-only. Ignora RLS — nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Mantenimiento: borra las fotos de altas manuales que ya pasaron los 7 días
# (altas_manuales_conteo.foto_path). Lo llama el workflow de n8n
# n8n/flujo-limpieza-fotos-altas.json via POST con el header
# X-Mantenimiento-Secret — mismo valor en los dos lados. Sin esta variable
# el endpoint rechaza TODO con 401, siempre (a diferencia de
# N8N_WEBHOOK_SECRET de callback-ia, que es opcional por empresa).
MANTENIMIENTO_SECRET=
